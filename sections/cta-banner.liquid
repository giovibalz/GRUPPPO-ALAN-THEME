<section class="cta-banner">
  <div class="cta-bg" style="background-image: url('{% if section.settings.image != blank %}{{ section.settings.image | img_url: '1800x' }}{% else %}https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?w=1800&q=80{% endif %}')"></div>
  <div class="cta-content">
    <div class="cta-eyebrow">{{ section.settings.eyebrow | default: 'Lavora con noi' }}</div>
    <h2 class="cta-title">{{ section.settings.title | default: 'Diventa un <em>rivenditore</em><br>Gruppo Alan' }}</h2>
    <p class="cta-sub">{{ section.settings.subtitle }}</p>
    <div class="cta-actions">
      <a href="{{ section.settings.btn1_url | default: '/pages/contatti' }}" class="btn-light">{{ section.settings.btn1_label | default: 'Richiedi Informazioni' }}</a>
      <a href="{{ section.settings.btn2_url | default: '#' }}" class="btn-outline-light">{{ section.settings.btn2_label | default: 'Scarica il Catalogo' }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Banner CTA",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Immagine sfondo" },
    { "type": "text", "id": "eyebrow", "label": "Testo sopra", "default": "Lavora con noi" },
    { "type": "textarea", "id": "title", "label": "Titolo" },
    { "type": "textarea", "id": "subtitle", "label": "Sottotitolo" },
    { "type": "text", "id": "btn1_label", "label": "Pulsante 1", "default": "Richiedi Informazioni" },
    { "type": "url", "id": "btn1_url", "label": "Link pulsante 1" },
    { "type": "text", "id": "btn2_label", "label": "Pulsante 2", "default": "Scarica il Catalogo" },
    { "type": "url", "id": "btn2_url", "label": "Link pulsante 2" }
  ],
  "presets": [{ "name": "Banner CTA" }]
}
{% endschema %}
